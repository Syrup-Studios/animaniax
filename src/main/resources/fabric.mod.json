{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "${description}",
  "authors": ["${authors}"],
  "contact": {
    "homepage": "${homepage}",
    "issues": "${issues}",
    "sources": "${sources}"
  },
  "license": "${license}",
  "environment": "*",
  "mixins": ["animaniax.mixins.json"],
  "entrypoints": {
    "main": ["net.syrupstudios.animaniax.loader.FabricEntrypoint"],
    "client": ["net.syrupstudios.animaniax.loader.FabricClientEntrypoint"]
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": ">=${fabricApi}",
    "syrup_library": ">=${syrupLibraryVersion}",
    "minecraft": "${minecraft}",
    "java": ">=21"
  }
}
